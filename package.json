{
  "name": "system-design",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run api\" \"npm run dev -w @sd/web\"",
    "web": "npm run dev -w @sd/web",
    "api": "npm run dev -w @sd/api",
    "db:init": "node scripts/db.mjs init",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:seed": "npm run seed -w @sd/api",
    "build": "npm run build -w @sd/web",
    "test": "npm run test -w @sd/engine",
    "db:reset": "npm run seed:reset -w @sd/api",
    "verify": "npm run verify -w @sd/api"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2"
  }
}
