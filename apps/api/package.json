{
  "name": "@sd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:reset": "tsx --env-file-if-exists=../../.env src/seed.ts --reset",
    "verify": "tsx --env-file-if-exists=../../.env src/verify.ts",
    "check:dropdowns": "tsx src/check-dropdowns.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@sd/domain": "*",
    "@sd/engine": "*",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
